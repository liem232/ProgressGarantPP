rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function getUserRole(uid) {
      return exists(userDocPath(uid)) ? get(userDocPath(uid)).data.role : null;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole(request.auth.uid) == 'admin';
    }

    function isManager() {
      return isAuthenticated() && (
        getUserRole(request.auth.uid) == 'manager' ||
        getUserRole(request.auth.uid) == 'admin'
      );
    }

    function isManagerUser(userId) {
      return getUserRole(userId) == 'manager' || getUserRole(userId) == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidProduct() {
      return request.resource.data.name is string 
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.category is string;
    }
    
    function isValidOrder() {
      return request.resource.data.orderData is map
        && request.resource.data.orderData.email is string
        && request.resource.data.orderData.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
        && request.resource.data.orderData.phone is string
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
    }
    
    // Products collection
    match /products/{productId} {
      allow read: if true;  // Anyone can read products
      allow create, update: if isAdmin() && isValidProduct();
      allow delete: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin() ||
        resource.data.role == 'manager' ||
        resource.data.role == 'admin'
      );
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // App config (public readable for authenticated, writable by admin)
    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.orderData.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && isValidOrder();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.orderData.userId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if isAdmin();
    }
    
    // Chat messages collection
    match /chatMessages/{messageId} {
      allow read, create, update, delete: if false;
    }

    // For thread document rules, use `resource.data` to avoid recursive reads.
    function isThreadDocParticipant() {
      return isAuthenticated() && resource.data.participantIds.hasAny([request.auth.uid]);
    }

    function isDeterministicThreadOwner(threadId) {
      return isAuthenticated() && threadId.matches('^' + request.auth.uid + '_.*$');
    }

    // For subcollection rules (messages), we must look up the parent thread.
    function isThreadParticipant(threadId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds.hasAny([request.auth.uid]);
    }

    // Private user-manager threads
    match /chatThreads/{threadId} {
      allow read: if isAdmin() || isManager() || (exists(/databases/$(database)/documents/chatThreads/$(threadId)) && isThreadDocParticipant()) || isDeterministicThreadOwner(threadId);

      allow create: if isAuthenticated();

      allow update: if exists(/databases/$(database)/documents/chatThreads/$(threadId)) && isThreadDocParticipant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage']);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isThreadParticipant(threadId) || isAdmin();
        allow create: if isThreadParticipant(threadId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (
            request.resource.data.text.size() > 0 ||
            (request.resource.data.attachments is list && request.resource.data.attachments.size() > 0)
          );
        allow update, delete: if isAdmin();
      }
    }
    
    // Chat rooms collection
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
