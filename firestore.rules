rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserRole(request.auth.uid) == 'admin' ||
        request.auth.token.email == 'admin@progressgarant.ru'
      );
    }

    function isManager() {
      return isAuthenticated() && (
        getUserRole(request.auth.uid) == 'manager' ||
        getUserRole(request.auth.uid) == 'admin' ||
        request.auth.token.email == 'manager@progressgarant.ru' ||
        request.auth.token.email == 'admin@progressgarant.ru'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidProduct() {
      return request.resource.data.name is string 
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.category is string;
    }
    
    function isValidOrder() {
      return request.resource.data.orderData is map
        && request.resource.data.orderData.email is string
        && request.resource.data.orderData.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
        && request.resource.data.orderData.phone is string
        && request.resource.data.orderData.userId is string
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
    }

    function isSafeUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'username',
        'firstName',
        'lastName',
        'phone',
        'photoURL',
        'address',
        'isPartner',
        'partnerApprovedAt'
      ]);
    }

    function isValidAttachment(att) {
      return att is map
        && att.keys().hasOnly(['id', 'name', 'url', 'type', 'size'])
        && att.id is string
        && att.name is string
        && att.url is string
        && att.type is string
        && att.size is number
        && att.size >= 0;
    }

    function isValidAttachmentsList(attachments) {
      return attachments is list
        && attachments.size() <= 10
        && (attachments.size() < 1 || isValidAttachment(attachments[0]))
        && (attachments.size() < 2 || isValidAttachment(attachments[1]))
        && (attachments.size() < 3 || isValidAttachment(attachments[2]))
        && (attachments.size() < 4 || isValidAttachment(attachments[3]))
        && (attachments.size() < 5 || isValidAttachment(attachments[4]))
        && (attachments.size() < 6 || isValidAttachment(attachments[5]))
        && (attachments.size() < 7 || isValidAttachment(attachments[6]))
        && (attachments.size() < 8 || isValidAttachment(attachments[7]))
        && (attachments.size() < 9 || isValidAttachment(attachments[8]))
        && (attachments.size() < 10 || isValidAttachment(attachments[9]));
    }

    function isValidThreadType(t) {
      return t == 'user-manager' || t == 'staff';
    }

    function isValidThreadCreate(threadId) {
      return request.resource.data.type is string
        && isValidThreadType(request.resource.data.type)
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && (
          (
            request.resource.data.type == 'user-manager'
            && request.resource.data.userId is string
            && request.resource.data.participantIds.hasAny([request.resource.data.userId])
            && threadId == 'um_' + request.resource.data.userId
            && (
              (
                request.resource.data.userId == request.auth.uid
                && request.resource.data.participantIds.hasAny([request.auth.uid])
              )
              ||
              isAdmin()
            )
          )
          ||
          (
            request.resource.data.type == 'staff'
            && request.resource.data.participantIds.hasAny([request.auth.uid])
            && threadId.matches('^staff_.*$')
            && (isAdmin() || isManager())
          )
        );
    }
    
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']));
      allow delete: if isAdmin();
    }

    match /orderCounter/counter {
      allow read, write: if isAuthenticated();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin() ||
        isManager() ||
        resource.data.role == 'manager' ||
        resource.data.role == 'admin'
      );
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        (isOwner(userId) && isSafeUserUpdate()) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        isManager() ||
        resource.data.orderData.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && isValidOrder();
      allow update: if isAuthenticated() && (
        isManager() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    match /partnershipRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'adminComment',
        'reviewedAt',
        'reviewedBy'
      ]);
      allow delete: if isAdmin();
    }

    match /chatMessages/{messageId} {
      allow read, create, update, delete: if false;
    }

    function isThreadDocParticipant() {
      return isAuthenticated()
        && resource != null
        && resource.data.participantIds.hasAny([request.auth.uid]);
    }

    function isDeterministicThreadOwner(threadId) {
      return isAuthenticated() && (
        threadId == 'um_' + request.auth.uid ||
        threadId.matches('^' + request.auth.uid + '_.*$')
      );
    }

    function isThreadParticipant(threadId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds.hasAny([request.auth.uid]);
    }

    match /chatThreads/{threadId} {
      allow read: if isAdmin() || isManager() || isDeterministicThreadOwner(threadId) || isThreadDocParticipant();

      allow create: if isAuthenticated() && isValidThreadCreate(threadId);

      allow update: if (
        isThreadDocParticipant() ||
        (isAdmin() && resource.data.type == 'user-manager')
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage']);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isThreadParticipant(threadId) || isAdmin() || isManager();
        allow create: if (
          isThreadParticipant(threadId) ||
          (isAdmin() && get(/databases/$(database)/documents/chatThreads/$(threadId)).data.type == 'user-manager')
        )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (!('attachments' in request.resource.data) || isValidAttachmentsList(request.resource.data.attachments))
          && (
            request.resource.data.text.size() > 0 ||
            ('attachments' in request.resource.data &&
             request.resource.data.attachments is list &&
             request.resource.data.attachments.size() > 0)
          );

        allow update, delete: if isAdmin();
      }
    }
    
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
